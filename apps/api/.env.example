# JWT signing key (required). Generate one with:  openssl rand -base64 48
# The prod profile refuses to start if it is blank, shorter than 32 bytes or this placeholder.
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48

# Comma-separated list of allowed CORS origins (required in prod)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Database (docker/prod profiles)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/meetstudent
SPRING_DATASOURCE_USERNAME=meetstudent
SPRING_DATASOURCE_PASSWORD=change_me

# Optional: external dev DB (docker profile fallback)
# CUSTOM_DEV_DB_URL=jdbc:postgresql://host:5432/meetstudent
# POSTGRES_USER=
# POSTGRES_PASSWORD=
