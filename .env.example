# Local Docker stack — copy to .env and fill in.
#   cp .env.example .env

# --- Secrets (no defaults, compose refuses to start without them) ---

# Long random string used to sign JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Password for the local Postgres container. Local and disposable — do NOT
# reuse the cloud database password here.
POSTGRES_PASSWORD=

# --- First admin account (optional locally) ---

# Created (or updated) at every API startup. Both or neither: with neither set, the
# seeded development admin admin@meetstudent.com / password stays usable. The password
# needs 12+ characters. Production (compose.prod.yml) requires both.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Optional overrides ---

# POSTGRES_DB=meetstudent
# POSTGRES_USER=meetstudent

# Host port for the Angular front. 4200 is the Angular default, so change it
# if you also run `ng serve` against the same machine.
# WEB_PORT=4200

# Host port for the back office.
# BO_PORT=4300

# --- Email (optional; OFF by default, nothing to set) ---

# Nothing is sent unless MAIL_ENABLED=true. To try every mail flow locally (verification, password
# reset, email change, contact form) with a catch-all inbox, uncomment these lines and start the
# stack with the optional Mailpit service:
#   docker compose --profile mail up --build
# then read the mails on http://localhost:8025 (bound to 127.0.0.1 only).
# MAIL_ENABLED=true
# MAIL_PROVIDER=custom
# SPRING_MAIL_HOST=mailpit
# SPRING_MAIL_PORT=1025
# MAIL_FROM=no-reply@meetstudent.local
# FRONTEND_BASE_URL=http://localhost:4200
# CONTACT_RECIPIENT=contact@meetstudent.local
#
# FRONTEND_BASE_URL may be plain http here: https is only enforced under the prod profile.
# For a real provider, MAIL_PROVIDER=brevo|gmail|ses fills in the connection defaults; see
# .env.production.example for the variables, and docs/DEPLOY.md for the checklist.
# Other optional variables passed through: MAIL_SES_REGION, SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD,
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH / _STARTTLS_ENABLE / _STARTTLS_REQUIRED / _SSL_ENABLE,
# APP_CONTACT_MAIL_RETRY_MAX_ATTEMPTS / _INITIAL_DELAY / _BACKOFF_MULTIPLIER, APP_CONTACT_MAIL_PENDING_TIMEOUT,
# APP_MAIL_TEST_COOLDOWN_SECONDS.
