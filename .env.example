# Local Docker stack — copy to .env and fill in.
#   cp .env.example .env

# --- Secrets (no defaults, compose refuses to start without them) ---

# Long random string used to sign JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# Password for the local Postgres container. Local and disposable — do NOT
# reuse the cloud database password here.
POSTGRES_PASSWORD=

# --- Optional overrides ---

# POSTGRES_DB=meetstudent
# POSTGRES_USER=meetstudent

# Host port for the Angular front. 4200 is the Angular default, so change it
# if you also run `ng serve` against the same machine.
# WEB_PORT=4200
