# Production environment for compose.prod.yml.
#   cp .env.production.example .env    # on the VPS, then edit
#   chmod 600 .env
# The real .env is gitignored. NEVER commit it. Compose reads ".env" by default.
# Values must not be quoted and must not contain spaces.

# --- Domains & TLS ---------------------------------------------------------

# Public site (web + API). DNS A record -> VPS IP. No scheme, no trailing slash.
DOMAIN=example.com
# Admin backoffice. DNS A record -> VPS IP.
BO_DOMAIN=admin.example.com
# Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com
# Leave unset in production. While testing, avoid rate limits with staging:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Browsers allowed to call the API cross-origin (the backoffice lives on another
# origin). Comma-separated, scheme included, no trailing slash.
# Compose expands ${DOMAIN}/${BO_DOMAIN} from the lines above.
CORS_ALLOWED_ORIGINS=https://${DOMAIN},https://${BO_DOMAIN}

# API base URL the backoffice calls (written into its /config.json at start).
# Default is https://${DOMAIN}/api/v1, so normally leave this commented out.
# BO_API_URL=https://example.com/api/v1

# --- Secrets (generate your own; no defaults, compose refuses to start) ----

# JWT signing key:  openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET_KEY=

# Postgres password:  openssl rand -base64 32 | tr -d '/+=\n'
# Set before the FIRST start; changing it later does not alter the existing
# database (use ALTER USER inside Postgres).
POSTGRES_PASSWORD=

# Initial admin account created by the API at first start.
ADMIN_EMAIL=admin@example.com
# At least 12 characters. Generate:  openssl rand -base64 18
ADMIN_PASSWORD=

# --- Tunables ---------------------------------------------------------------

# Lifetime of the access token (the refresh token rotates in the database).
JWT_ACCESS_TTL_MINUTES=15

# POSTGRES_DB=meetstudent
# POSTGRES_USER=meetstudent

# --- Email (optional; OFF by default) -----------------------------------------
# Account mails (verification, password reset, email change) and the contact-form mail to the team.
# Nothing is sent unless MAIL_ENABLED=true; without it the API runs normally and the contact form
# still stores its messages. Health checks never contact SMTP. SPRING_MAIL_PASSWORD is a secret:
# .env stays chmod 600. Values are not quoted and contain no spaces.
#
# Three providers are built in as presets (MAIL_PROVIDER): brevo, gmail, ses. A preset only supplies
# DEFAULTS for the connection (host, port 587, auth, mandatory STARTTLS): any SPRING_MAIL_* variable
# you set explicitly still wins. Credentials always come from SPRING_MAIL_USERNAME / _PASSWORD.
#
# >>> MINIMAL SETUP, Brevo (recommended): uncomment these 6 lines and fill them in. <<<
# MAIL_ENABLED=true
# MAIL_PROVIDER=brevo
# MAIL_FROM=no-reply@example.com
# SPRING_MAIL_USERNAME=your-brevo-smtp-login
# SPRING_MAIL_PASSWORD=your-brevo-smtp-key
# CONTACT_RECIPIENT=contact@example.com
#   - MAIL_FROM must be a sender validated in the Brevo dashboard (and ideally on a domain you authenticated).
#   - The password is the SMTP key (Brevo > SMTP & API > SMTP), NOT the API key.
#
# >>> Switch to GMAIL: change exactly these lines (needs 2-step verification + an app password) <<<
# MAIL_PROVIDER=gmail
# MAIL_FROM=your.address@gmail.com
# SPRING_MAIL_USERNAME=your.address@gmail.com
# SPRING_MAIL_PASSWORD=sixteenletterapppassword
#   (the app password is 16 letters; write it WITHOUT the spaces Google displays; your normal password does not work.)
#
# >>> Switch to AWS SES: change exactly these lines <<<
# MAIL_PROVIDER=ses
# MAIL_SES_REGION=eu-west-1
# MAIL_FROM=no-reply@your-verified-domain.com
# SPRING_MAIL_USERNAME=your-ses-smtp-username
# SPRING_MAIL_PASSWORD=your-ses-smtp-password
#   (SES SMTP credentials, generated in the SES console: NOT your IAM access keys. MAIL_FROM must be a
#   verified identity in that same region. In the SES sandbox only verified recipients receive mail.)
#
# --- Every mail variable (all optional unless stated) ---
# MAIL_ENABLED=false                 true to send. Default false.
# MAIL_PROVIDER=custom               brevo | gmail | ses | custom. custom (default) = no preset, only SPRING_MAIL_*.
# MAIL_SES_REGION=eu-west-1          SES region (MAIL_PROVIDER=ses only).
# MAIL_FROM=                         Sender address. Required when MAIL_ENABLED=true.
# FRONTEND_BASE_URL=                 Origin used in email links, https, no path. Defaults to https://${DOMAIN}.
# CONTACT_RECIPIENT=                 Mailbox receiving the contact form. Default contact@meetstudent.com.
# SPRING_MAIL_HOST=                  SMTP host. Required when MAIL_ENABLED=true unless a preset gives it.
# SPRING_MAIL_PORT=                  SMTP port.
# SPRING_MAIL_USERNAME=              SMTP login (secret-ish).
# SPRING_MAIL_PASSWORD=              SMTP password / key (secret).
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=              true when the server needs a login.
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=   true for port 587.
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED= true with STARTTLS: without it STARTTLS is opportunistic and
#                                    the connection (credentials included) can be downgraded to plain text.
#                                    Defaults to the STARTTLS_ENABLE value.
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=        true for implicit TLS (port 465); leave STARTTLS unset then.
# APP_CONTACT_MAIL_RETRY_MAX_ATTEMPTS=3               Contact mail: attempts on a transient failure (1 to 5).
# APP_CONTACT_MAIL_RETRY_INITIAL_DELAY=2s             Wait before the 2nd attempt (then x BACKOFF_MULTIPLIER, capped at 60s).
# APP_CONTACT_MAIL_RETRY_BACKOFF_MULTIPLIER=5
# APP_CONTACT_MAIL_PENDING_TIMEOUT=15m                A contact message PENDING longer than this can be resent (before: 409).
# APP_MAIL_TEST_COOLDOWN_SECONDS=10                   Minimum seconds between two admin SMTP tests (0 = no limit).
#
# >>> Generic provider on port 465 (implicit TLS), no preset <<<
# MAIL_ENABLED=true
# MAIL_PROVIDER=custom
# MAIL_FROM=no-reply@example.com
# SPRING_MAIL_HOST=smtp.your-provider.com
# SPRING_MAIL_PORT=465
# SPRING_MAIL_USERNAME=...
# SPRING_MAIL_PASSWORD=...
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
#
# After starting, check it from the admin session:  POST /api/v1/admin/mail/test  (see docs/DEPLOY.md, section 2b).

# --- Backups (used by scripts/backup.sh, optional) --------------------------
# BACKUP_DIR=/var/backups/meetstudent
# BACKUP_KEEP_DAYS=14
